{
    "markdown link": {
        "prefix": ["lnk"],
        "body": ["[${1:label}](${2:url})"]
    },
    "reference": {
        "prefix": ["ref"],
        "body": ["[^${1:label}]: <${2:url}> \"{$3:title}\""]
    },
    "Title --- frontmatter": {
        "prefix": ["title"],
        "body": [
            "---",
            "title: ",
            "date: ${CURRENT_YEAR}-${CURRENT_MOTNH}-${CURRENT_DATE}",
            "---"
        ]
    }
}
