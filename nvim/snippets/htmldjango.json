{
    "AGPL SPDX header": {
        "prefix": ["agpl"],
        "body": [
            "{# SPDX-License-Identifier: AGPL-3.0-or-later #}",
            "{# SPDX-FileCopyrightText: ${1:year} ${2:author} #}"
        ]
    },
    "Translation": {
        "prefix": ["trans"],
        "body": ["{% translate '${1:string}' %}"]
    },
    "Block translation": {
        "prefix": ["blocktrans"],
        "body": [
            "{% blocktranslate %}",
            "${1:string}",
            "{% endblocktranslate %}"
        ]
    },
    "Block": {
        "prefix": ["block"],
        "body": ["{% block ${1:blockname} %}", "{% endblock ${1:blockname} %}"]
    },
    "Block with super": {
        "prefix": ["blocksuper"],
        "body": [
            "{% block ${1:blockname} %}",
            "    {{ block.super }}",
            "{% endblock ${1:blockname} %}"
        ]
    }
}
